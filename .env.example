# Copy to .env and adjust values.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ctfoj
POSTGRES_USER=ctfoj
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_ROOT_PASSWORD=change_me_in_production

# Backend
BACKEND_HTTP_ADDR=:8081
BACKEND_LOG_LEVEL=info
BACKEND_JWT_SECRET=replace_with_a_long_random_string
BACKEND_JWT_ACCESS_TTL=15m
BACKEND_JWT_REFRESH_TTL=720h
BACKEND_REGISTER_OPEN=true
BACKEND_STORAGE_DRIVER=local
BACKEND_STORAGE_LOCAL_DIR=/data/uploads
BACKEND_RATE_LIMIT_RPM=120

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Dynamic challenges (容器实例)
BACKEND_INSTANCE_PUBLIC_HOST=localhost
BACKEND_INSTANCE_PORT_MIN=30000
BACKEND_INSTANCE_PORT_MAX=40000
BACKEND_INSTANCE_DEFAULT_TTL=2h
BACKEND_INSTANCE_MAX_PER_USER=1
BACKEND_INSTANCE_FLAG_PREFIX=flag

# Worker
WORKER_INTERVAL_SECONDS=30

# Frontend / Caddy
PUBLIC_HTTP_PORT=8080
